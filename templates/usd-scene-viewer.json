      "inputs": ["value"],
      "outputs": [],
      "input_types": {"value": "Any"},
      "output_types": {},
      "input_defaults": {}
    },
    "status": {
      "id": "status",
      "type": "Output",
      "params": {"label": "Newton Status"},
      "pos": [900, 390],
      "inputs": ["value"],
      "outputs": [],
      "input_types": {"value": "Any"},
      "output_types": {},
      "input_defaults": {}
    }
  },
  "edges": [
    {"from": "scene", "from_port": "scene", "to": "simulation", "to_port": "scene"},
    {"from": "viewer", "from_port": "viewer", "to": "simulation", "to_port": "viewer"},
    {"from": "simulation", "from_port": "viewer_url", "to": "viewer_url", "to_port": "value"},
    {"from": "simulation", "from_port": "session", "to": "status", "to_port": "value"}
  ]
