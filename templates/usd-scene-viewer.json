        "joint_stiffness": "Float", "joint_damping": "Float", "joint_drive_overrides": "Dict",
        "max_velocity_deg_s": "Float", "max_step_deg": "Float"
      },
      "output_types": {
        "ok": "Bool", "running": "Bool", "armed": "Bool", "phase": "Text", "session": "Dict",
        "positions": "Dict", "rigid_bodies": "Dict", "viewer_url": "Text", "report": "Text"
      },
      "input_defaults": {
        "action": "status", "run_id": "newton-usd-scene", "scene": {}, "viewer": {},
        "device": "auto", "fps": 60, "substeps": 4, "solver_iterations": 16,
        "joint_stiffness": 100000000.0, "joint_damping": 100000.0,
        "joint_drive_overrides": {},
        "max_velocity_deg_s": 45.0, "max_step_deg": 2.0
      }
