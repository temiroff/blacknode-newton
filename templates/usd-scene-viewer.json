      ],
      "outputs": [
        "ok", "running", "armed", "phase", "session", "positions", "rigid_bodies",
        "viewer_url", "report"
      ],
      "input_types": {
        "trigger": "Any", "action": "Enum", "run_id": "Text", "scene": "Dict", "viewer": "Dict",
